# ─────────────────────────────────────────────────────────────────────────────
# ScanMaster — environment template
#
# Copy to `.env.local` and fill in the values. `.env.local` is git-ignored and
# must NEVER be committed.
#
#   cp .env.example .env.local
#
# SECURITY RULES
#   • Only NEXT_PUBLIC_* values are ever exposed to the app bundle.
#   • Only the Supabase *publishable* / *anon* key may be used. They are
#     designed to be public and Row Level Security is what protects your data.
#   • NEVER put the service-role / admin key here. It belongs only in a server
#     environment, never in the app, never in the bundle, never in git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...) or legacy anon JWT (eyJ...).
# Public-safe. Protects nothing on its own - RLS does.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
# Server-side only (no NEXT_PUBLIC_ prefix): stays out of the client bundle.
OPENROUTER_API_KEY=

# Model id used for AI features, e.g. openai/gpt-4o-mini
AI_MODEL=

# ── Advertising (AdMob) ───────────────────────────────────────────────────────
# These are public identifiers, safe to ship.
NEXT_PUBLIC_ADMOB_APP_ID=
NEXT_PUBLIC_ADMOB_BANNER_ID=
NEXT_PUBLIC_ADMOB_INTERSTITIAL_ID=
NEXT_PUBLIC_ADMOB_REWARDED_ID=
NEXT_PUBLIC_ADMOB_TEST_MODE=true

# ── Backend ───────────────────────────────────────────────────────────────────
# Base URL of the deployed API that the app talks to. Must be HTTPS in release.
NEXT_PUBLIC_API_BASE_URL=

# ── Database (SERVER SIDE ONLY — never expose to the client) ──────────────────
# Used only by server-side tooling. Do NOT prefix with NEXT_PUBLIC_.
# DATABASE_URL=
