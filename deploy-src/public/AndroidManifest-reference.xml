<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml for ScanMaster AI TWA (Trusted Web Activity).
  
  This file is a reference for when wrapping the PWA as an Android app
  using Bubblewrap (https://github.com/nicholasgasior/nicholasgasior) or PWABuilder.
  
  The key permissions required for camera access in Android WebView/TWA:
  - android.permission.CAMERA: Required for getUserMedia() to access camera
  - android.hardware.camera: Indicates the app uses camera hardware
  
  When building with Bubblewrap, these permissions are automatically added
  if the manifest.json contains "permissions": ["camera"].
  
  For custom WebView wrappers, ensure:
  1. WebChromeClient.onPermissionRequest() grants camera permission
  2. The WebView settings allow media playback:
     - settings.mediaPlaybackRequiresUserGesture = false
     - settings.domStorageEnabled = true
  3. The WebView loads the app over HTTPS
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.scanmaster.ai">

    <!-- Camera permission for document scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Internet permission for web access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Storage for saving PDFs -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="ScanMaster AI"
        android:supportsRtl="true"
        android:theme="@style/Theme.LauncherActivity"
        android:usesCleartextTraffic="false">

        <!-- Main TWA Activity -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://scanmaster.ai" />

            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/colorPrimary" />

            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/colorPrimaryDark" />

            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/splash" />

            <meta-data
                android:name="android.support.customtabs.trusted.SCREEN_ORIENTATION"
                android:value="portrait" />
        </activity>

        <!-- Permission Request Activity for camera -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.FocusActivity"
            android:exported="false" />

        <!-- Deeplink handler -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:exported="false">
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

    </application>
</manifest>
