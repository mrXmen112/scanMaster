<?xml version="1.0" encoding="utf-8"?>
<!--
    Base splash drawable.

    This used to be a purple/teal gradient, which fought the ScanMaster navy
    branding and flashed a light frame on cold start. It is now the brand
    background with the centred mark, and it also serves as the required base
    declaration for the per-density drawable-port-*/drawable-land-* variants.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/splashBackground" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="120dp"
        android:height="120dp">
        <bitmap
            android:src="@drawable/splash_icon"
            android:gravity="center" />
    </item>
</layer-list>
